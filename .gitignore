# Credentials -- never commit real login details
.env

# Reinstalled per machine
node_modules/

# Per-machine runtime state and output
sessions/
logs/
reports/
screenshots/

# Local data entries are personal to whoever's running this install
data/dailyLog.xlsx
data/~$*.xlsx
data/locations.json

# OS/editor noise
.DS_Store
Thumbs.db

# Local dev-preview tooling config, not part of the app
.claude/

# Half-written copies of the data file (the app saves to a temp file, then renames it into place)
data/*.tmp
